+{% extends "base.html" %}
+{% block title %}{{ task.title }} - MPMS{% endblock %}
+{% block content %}
+<p class="small"><a href="{{ url_for('projects.show_project', project_id=task.project_id) }}">&larr; {{ task.project.name }}</a></p>
+<div class="d-flex justify-content-between align-items-center">
+  <h1 class="h3">{{ task.title }}</h1>
+  {% if can_manage %}
+  <div>
+    <a class="btn btn-sm btn-outline-secondary" href="{{ url_for('tasks.edit_task', task_id=task.id) }}">Edit</a>
+    <a class="btn btn-sm btn-outline-danger" href="{{ url_for('tasks.delete_task', task_id=task.id) }}">Delete</a>
+  </div>
+  {% endif %}
+</div>
+<p class="text-muted">
+  Priority: {{ task.priority }} | Due: {{ task.due_date or '-' }} |
+  Status: {{ task.status }} |
+  Assignee: {{ task.assignee.name if task.assignee else 'Unassigned' }}
+</p>
+{% if task.description %}<p>{{ task.description }}</p>{% endif %}
+
+<h2 class="h5 mt-4">Comments ({{ comments|length }})</h2>
+{% for c in comments %}
+<div class="card mb-2"><div class="card-body py-2">
+  <div class="small text-muted"><strong>{{ c.user.name }}</strong> - {{ c.created_at.strftime('%Y-%m-%d %H:%M') }} UTC</div>
+  <div>{{ c.text }}</div>
+</div></div>
+{% else %}
+<p class="text-muted">No comments yet.</p>
+{% endfor %}
+
+<form method="post" action="{{ url_for('tasks.add_comment', task_id=task.id) }}" class="mt-3">
+  <div class="mb-2"><label class="form-label" for="text">Add a comment</label>
+    <textarea class="form-control" id="text" name="text" rows="2" maxlength="1000" required></textarea></div>
+  <button class="btn btn-primary" type="submit">Post comment</button>
+</form>
+{% endblock %}
